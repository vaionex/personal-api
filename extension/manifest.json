{
	"manifest_version": 3,
	"name": "Personal API — LinkedIn Assistant",
	"version": "1.0.0",
	"description": "AI-powered LinkedIn message assistant. Drafts replies in your voice.",
	"permissions": ["storage", "activeTab"],
	"host_permissions": ["https://www.linkedin.com/*"],
	"content_scripts": [
		{
			"matches": ["https://www.linkedin.com/messaging/*"],
			"js": ["content.js"],
			"css": ["styles.css"],
			"run_at": "document_idle"
		}
	],
	"options_page": "options.html",
	"icons": {
		"48": "icon48.png",
		"128": "icon128.png"
	}
}

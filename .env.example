# Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Provider Configuration
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-20250514
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
OWNER_TELEGRAM_ID=your-telegram-user-id
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret-token

# App Config
PUBLIC_APP_NAME=Personal API
PUBLIC_OWNER_NAME=Your Name
PUBLIC_APP_URL=https://your-domain.com

# Admin Auth
ADMIN_PASSWORD=your-secret-admin-password

# API Auth (optional - comma-separated list of valid API keys)
PAPI_API_KEYS=key1,key2,key3

# Google Calendar (optional — for real-time availability)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token
GOOGLE_CALENDAR_ID=primary

# Webhook Notifications (Discord/Slack/Generic)
NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/...

# Email Notifications (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.com
